    {
      "name": "Phone Verification",
      "item": [
        {
          "name": "Send Verification Code (For New User Registration)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+1234567890\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/verification/send-code",
              "host": ["{{baseUrl}}"],
              "path": ["api", "verification", "send-code"]
            }
          },
          "description": "Use this endpoint for new user registration. This endpoint will block if the phone number is already verified for another user."
        },
        {
          "name": "Verify Phone Number",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+1234567890\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/verification/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "verification", "verify"]
            }
          }
        },
        {
          "name": "Resend Verification Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+1234567890\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/verification/resend-code",
              "host": ["{{baseUrl}}"],
              "path": ["api", "verification", "resend-code"]
            }
          }
        },
        {
          "name": "Register User After Verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+1234567890\",\n  \"userRole\": \"traveller\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/verification/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "verification", "register"]
            }
          }
        }
      ]
    },
